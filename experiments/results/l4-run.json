    {
      "name": "retry.py",
      "metadata": {
        "lines": 11
      },
      "segments": [
        {
          "text": "\"\"\"Retry failed API requests with exponential backoff.\"\"\"\nimport time\n",
          "line_start": 1,
          "line_end": 3
        },
        {
          "text": "def retry_request(request, attempts=3):\n    for attempt in range(attempts):\n        try:\n            return request()\n        except ConnectionError:\n            if attempt == attempts - 1:\n                raise\n            time.sleep(2 ** attempt)",
          "line_start": 4,
          "line_end": 11
        }
      ],
      "offset": 3,
      "count": 2,
      "sha256": "23641afe4500fd3ce5cd6557bf9c254e3c84c46336c83198c3b016dd20cb3119"
    },
    {
      "name": "normalize.py",
      "metadata": {
        "lines": 8
      },
      "segments": [
        {
          "text": "\"\"\"Normalize vectors for cosine similarity.\"\"\"\nimport numpy as np\n",
          "line_start": 1,
          "line_end": 3
        },
        {
          "text": "def normalize_vector(vector):\n    norm = np.linalg.norm(vector)\n    if norm == 0:\n        raise ValueError(\"zero vector\")\n    return vector / norm",
          "line_start": 4,
          "line_end": 8
        }
      ],
